---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, LANGS, useTranslations, type Lang } from '../i18n/ui.ts';
import { localePath, logicalPath, url } from '../i18n/paths.ts';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Use the wider homepage container instead of the reading width. */
  wide?: boolean;
  /** Pages without a localised twin (404) disable canonical/alternate links. */
  standalone?: boolean;
}

const { lang, title, description, wide = false, standalone = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · ${t('site.name')}` : `${t('site.name')} — ${t('site.tagline')}`;
const pageDescription = description ?? t('site.description');
const path = standalone ? '/' : logicalPath(Astro.url.pathname);
const canonical = new URL(localePath(lang, path), Astro.site);
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {!standalone && <link rel="canonical" href={canonical} />}
    {!standalone && LANGS.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localePath(l, path), Astro.site)} />)}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Apply the theme before first paint: explicit choice > system preference.
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('lg-theme'); } catch (e) {}
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking web fonts; system fonts render first. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2 focus:border focus:border-line"
    >
      {t('nav.skip')}
    </a>
    <Header lang={lang} path={path} />
    <main id="main" class:list={['mx-auto w-full flex-1 px-4 sm:px-6 py-8 sm:py-12', wide ? 'max-w-[1000px]' : 'max-w-[760px]']}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
