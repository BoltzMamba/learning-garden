---
/**
 * Dev-only stress page for the graph renderer (synthetic data, never built):
 * /lab-graph/stress/ renders ~400 nodes in both modes so frame times can be measured.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GraphView from '../../components/GraphView.astro';
import type { GraphData } from '../../lib/graph.ts';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: 'stress' } }] : [];
}

// Deterministic synthetic graph: 300 articles (15 overviews) in loose clusters, 60 topics, 40 questions.
let seed = 7;
const rand = () => ((seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648);
const nodes: GraphData['nodes'] = [];
const edges: GraphData['edges'] = [];
for (let i = 0; i < 300; i++) {
  nodes.push({ id: `note:n${i}`, kind: 'article', contentType: i % 20 === 0 ? 'overview' : 'note', label: `Synthetic note ${i}`, path: '/notes/' });
}
for (let i = 0; i < 60; i++) nodes.push({ id: `topic:t${i}`, kind: 'topic', label: `topic${i}`, path: '/notes/' });
for (let i = 0; i < 40; i++) nodes.push({ id: `q:q${i}`, kind: 'question', label: `Question ${i}`, path: '/questions/' });
for (let i = 10; i < 60; i++) edges.push({ source: `topic:t${i % 10}`, target: `topic:t${i}`, kind: 'parent_of' });
for (let i = 0; i < 300; i++) {
  const cluster = Math.floor(i / 20);
  if (i % 20 !== 0) edges.push({ source: `note:n${i}`, target: `note:n${cluster * 20}`, kind: 'belongs_to' });
  for (let k = 0; k < 2; k++) {
    const j = cluster * 20 + Math.floor(rand() * 20);
    if (j !== i && j < 300) edges.push({ source: `note:n${i}`, target: `note:n${j}`, kind: k ? 'related_to' : 'links_to' });
  }
  edges.push({ source: `note:n${i}`, target: `topic:t${10 + Math.floor(rand() * 50)}`, kind: 'tagged_with' });
}
for (let i = 0; i < 40; i++) edges.push({ source: `q:q${i}`, target: `note:n${Math.floor(rand() * 300)}`, kind: 'asks_about' });
---

<BaseLayout lang="en" title="Graph stress test" wide>
  <GraphView lang="en" graph={{ nodes, edges }} variant="full" />
</BaseLayout>
