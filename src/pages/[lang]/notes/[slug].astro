---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categoryLabel, htmlLang, intlLocale, LANGS, useTranslations, type Lang } from '../../../i18n/ui.ts';
import { localePath } from '../../../i18n/paths.ts';
import { getGarden, getGardenView } from '../../../lib/garden.ts';
import { formatDisplayDate } from '../../../lib/dates.ts';
import { githubHistoryUrl, githubSourceUrl, newQuestionIssueUrl } from '../../../lib/site.ts';
import { localGraph, noteConnections, noteNodeId } from '../../../lib/graph.ts';
import { topicLabel } from '../../../lib/topics.ts';
import GraphView from '../../../components/GraphView.astro';
import TopicChips from '../../../components/TopicChips.astro';
import ConceptLayer from '../../../components/ConceptLayer.astro';
import MermaidDiagrams from '../../../components/MermaidDiagrams.astro';

export async function getStaticPaths() {
  // One page per logical note and language (ids come from the Chinese source).
  const { sources } = await getGarden();
  return LANGS.flatMap((lang) => sources.map((note) => ({ params: { lang, slug: note.id } })));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const locale = intlLocale[lang];
const { notesById, revisionsByNote, reviewDatesByNote, publicQuestions, graph, vocab, topicsByNote, seriesByOverview, concepts } =
  await getGardenView(lang);
const note = notesById.get(Astro.params.slug!)!;
// English pages show the English edition; the Chinese text appears there only
// in `astro dev` while a translation is missing (production builds are strict).
const untranslated = lang === 'en' && note.contentLang !== 'en';
const status = note.translationStatus;
const machineAssisted = lang === 'en' && !untranslated && status?.startsWith('AUTO_');
const manualStale = lang === 'en' && status === 'MANUAL_STALE';
const isOverview = note.data.contentType === 'overview';
// Local graph: one hop of real relations (body links, related, series, questions).
const local = localGraph(graph, noteNodeId(note.id), 'article', 1);
const { backlinks, outlinks, related } = noteConnections(graph, note.id);
const noteTitle = (id: string) => notesById.get(id)?.data.title ?? id;
const { Content } = await render(note.contentEntry);
const hasBody = (note.body ?? '').trim().length > 0;

// Concepts this page references (written by remark-concepts as data-concept),
// with definitions in the page language and the source in the same language.
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const usedConcepts = [...new Set([...(note.contentEntry.rendered?.html ?? '').matchAll(/data-concept="([^"]+)"/g)].map((m) => m[1]))]
  .map((id) => concepts.get(id))
  .filter((c) => c !== undefined)
  .map((c) => ({
    id: c.id,
    term: c[lang].term,
    otherTerm: c[otherLang].term !== c[lang].term ? c[otherLang].term : undefined,
    otherLang: htmlLang[otherLang],
    definition: c[lang].definition,
    sourceTitle: noteTitle(c.source.note),
    href: c.source.note === note.id ? `#${c.source.anchor}` : `${localePath(lang, `/notes/${c.source.note}/`)}#${c.source.anchor}`,
  }));

// Series: the contents of an overview, or this note's place in its series.
const members = isOverview ? (seriesByOverview.get(note.id) ?? []) : [];
const series = note.data.series ? notesById.get(note.data.series) : undefined;
const siblings = series ? (seriesByOverview.get(series.id) ?? []) : [];
const position = siblings.findIndex((n) => n.id === note.id);
const prev = position > 0 ? siblings[position - 1] : undefined;
const next = position >= 0 && position < siblings.length - 1 ? siblings[position + 1] : undefined;
const topics = (topicsByNote.get(note.id) ?? []).map((id) => ({ id, label: topicLabel(vocab, id, lang) }));

const filePath = note.filePath ?? `src/content/notes/${note.id}.md`;
const revisions = [...(revisionsByNote.get(note.id) ?? [])].reverse();
const reviewDates = reviewDatesByNote.get(note.id) ?? [];
const questions = publicQuestions.filter((q) => q.data.note === note.id);
const fmt = (d: string) => formatDisplayDate(d, locale);
---

<BaseLayout lang={lang} title={note.data.title} description={note.data.description}>
  <a href={localePath(lang, '/notes/')} class="text-sm text-muted hover:text-accent">{t('note.back')}</a>

  <article class="mt-6" lang={htmlLang[note.contentLang]}>
    <header class="mb-8">
      <p class="font-mono text-xs text-accent flex flex-wrap items-center gap-2">
        <a href={localePath(lang, `/notes/category/${note.data.category}/`)} class="hover:underline">
          {categoryLabel(note.data.category, lang)}
        </a>
        {
          isOverview && (
            <span class="chip">
              {t('series.badge')} · {t('series.count', { n: members.length })}
            </span>
          )
        }
      </p>
      <h1 class="mt-2 text-2xl sm:text-3xl font-semibold leading-tight tracking-tight">{note.data.title}</h1>
      <p class="mt-3 text-muted">{note.data.description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
        <span>
          {t('note.published')} <time datetime={note.data.published} class="font-mono">{fmt(note.data.published)}</time>
        </span>
        <TopicChips lang={lang} topics={topics} label={t('note.tags')} />
        {
          usedConcepts.length > 0 && (
            <button type="button" class="chip sm:ml-auto" data-concept-toggle aria-pressed="false" title={t('concepts.modeHint')}>
              {t('concepts.mode')}
            </button>
          )
        }
      </div>
      {
        untranslated && (
          <p class="mt-4 text-sm border-l-2 border-accent pl-3" lang="en" data-translation-missing>
            {t('note.translation.missing')}
          </p>
        )
      }
      {
        (machineAssisted || manualStale) && (
          <p class="mt-4 text-xs text-muted" lang="en" data-translation={status}>
            {t(manualStale ? 'note.translation.manualStale' : 'note.translation.auto')}{' '}
            <a class="link" href={localePath('zh', `/notes/${note.id}/`)} hreflang="zh-CN">
              {t('note.translation.original')}
            </a>
          </p>
        )
      }
      {
        series && (
          <p class="mt-4 text-sm text-muted border-l-2 border-accent pl-3">
            {t('series.partOf')}:{' '}
            <a class="link" href={localePath(lang, `/notes/${series.id}/`)}>
              {series.data.title}
            </a>
            <span class="font-mono text-xs"> · {t('series.position', { i: position + 1, n: siblings.length })}</span>
          </p>
        )
      }
    </header>

    {
      hasBody && (
        <section aria-labelledby={isOverview ? 'overview-heading' : undefined}>
          {isOverview && (
            <h2 id="overview-heading" class="section-title mb-4">
              {t('series.overview')}
            </h2>
          )}
          <div class="prose">
            <Content />
          </div>
        </section>
      )
    }

    {
      isOverview && (
        <section class:list={[hasBody && 'mt-12']} aria-labelledby="contents-heading">
          <h2 id="contents-heading" class="section-title">
            {t('series.contents')}
          </h2>
          {members.length ? (
            <ol class="mt-3 divide-y divide-line border-y border-line">
              {members.map((m, i) => (
                <li class="py-3 grid grid-cols-[2.5rem_1fr] gap-2">
                  <span class="font-mono text-xs text-muted pt-1">{String(i + 1).padStart(2, '0')}</span>
                  <div class="min-w-0">
                    <a href={localePath(lang, `/notes/${m.id}/`)} class="font-semibold hover:text-accent">
                      {m.data.title}
                    </a>
                    <p class="mt-0.5 text-sm text-muted">{m.data.description}</p>
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <p class="mt-3 text-sm text-muted">{t('series.empty', { id: note.id })}</p>
          )}
        </section>
      )
    }

    {
      (prev || next) && (
        <nav class="mt-10 flex flex-wrap justify-between gap-4 text-sm" aria-label={t('series.partOf')}>
          {prev ? (
            <a class="link" href={localePath(lang, `/notes/${prev.id}/`)}>
              {t('series.prev')} {prev.data.title}
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="link text-right" href={localePath(lang, `/notes/${next.id}/`)}>
              {next.data.title} {t('series.next')}
            </a>
          )}
        </nav>
      )
    }
  </article>

  <aside class="mt-12 card p-5" aria-labelledby="timeline-heading">
    <h2 id="timeline-heading" class="section-title">{t('note.timeline')}</h2>
    <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-medium">{t('note.revisions')}</dt>
        <dd class="mt-1 text-muted">
          {
            revisions.length ? (
              <ul class="space-y-1">
                {revisions.map((r) => (
                  <li>
                    <time datetime={r.date} class="font-mono text-xs">
                      {r.date}
                    </time>{' '}
                    {r.summary}
                  </li>
                ))}
              </ul>
            ) : (
              t('note.noRevisions')
            )
          }
        </dd>
      </div>
      <div>
        <dt class="font-medium">{t('note.reviews')}</dt>
        <dd class="mt-1 text-muted">
          {
            reviewDates.length ? (
              <>
                {t('note.reviewCount', { n: reviewDates.length })}
                <br />
                {t('note.lastReviewed', { date: fmt(reviewDates.at(-1)!) })}
              </>
            ) : (
              t('note.neverReviewed')
            )
          }
        </dd>
      </div>
    </dl>
    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a class="link" href={githubHistoryUrl(filePath)}>{t('note.history')}</a>
      <a class="link" href={githubSourceUrl(filePath)}>{t('note.source')}</a>
    </p>
  </aside>

  <section class="mt-8" aria-labelledby="connections-heading">
    <h2 id="connections-heading" class="section-title">{t('graph.connections')}</h2>
    {
      local.nodes.length > 1 ? (
        <div class="mt-3">
          <GraphView lang={lang} graph={local} variant="local" center={noteNodeId(note.id)} />
        </div>
      ) : (
        <p class="mt-3 text-sm text-muted">{t('graph.localEmpty')}</p>
      )
    }
    <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
      {
        [
          { label: t('graph.backlinks'), ids: backlinks, empty: t('graph.noBacklinks') },
          { label: t('graph.outlinks'), ids: outlinks, empty: undefined },
          { label: t('graph.related'), ids: related, empty: undefined },
        ]
          .filter((g) => g.ids.length > 0 || g.empty)
          .map((g) => (
            <div>
              <dt class="font-medium">{g.label}</dt>
              <dd class="mt-1 text-muted">
                {g.ids.length ? (
                  <ul class="space-y-1">
                    {g.ids.map((id) => (
                      <li>
                        <a class="link" href={localePath(lang, `/notes/${id}/`)}>
                          {noteTitle(id)}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  g.empty
                )}
              </dd>
            </div>
          ))
      }
    </dl>
  </section>

  <section class="mt-8" aria-labelledby="questions-heading">
    <h2 id="questions-heading" class="section-title">{t('note.questions')}</h2>
    {
      questions.length ? (
        <ul class="mt-3 space-y-2 text-sm">
          {questions.map((q) => (
            <li class="flex flex-wrap items-baseline gap-2">
              <span class="chip">{t(q.data.status === 'open' ? 'q.status.open' : 'q.status.resolved')}</span>
              <a class="link" href={`${localePath(lang, '/questions/')}#q-${q.id}`}>
                {q.data.title}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 text-sm text-muted">{t('note.noQuestions')}</p>
      )
    }
    <p class="mt-4 text-sm">
      <a class="link" href={newQuestionIssueUrl(note.id, note.data.title)}>{t('note.ask')}</a>
    </p>
  </section>

  {usedConcepts.length > 0 && <ConceptLayer lang={lang} concepts={usedConcepts} />}
  <MermaidDiagrams />
</BaseLayout>
