---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AsciiOcean from '../../components/AsciiOcean.astro';
import ActivityCalendar from '../../components/ActivityCalendar.astro';
import NoteList from '../../components/NoteList.astro';
import { LANGS, useTranslations, type Lang } from '../../i18n/ui.ts';
import { localePath } from '../../i18n/paths.ts';
import { getGarden } from '../../lib/garden.ts';
import { todayInTimeZone } from '../../lib/dates.ts';
import { profile } from '../../data/profile.ts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { notes, events } = await getGarden();
const today = todayInTimeZone();
---

<BaseLayout lang={lang} wide>
  <section class="mb-10 max-w-[760px]">
    <p class="font-mono text-sm text-accent">$ whoami</p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">
      {t('home.hello')} <span class="font-mono">{profile.name}</span>
    </h1>
    <p class="mt-4 text-muted leading-relaxed">{t('home.intro')}</p>
    <p class="mt-3 text-sm text-muted italic border-l-2 border-dashed border-line pl-3">{profile.tagline[lang]}</p>
    <p class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <span class="text-muted">{t('home.focus')}:</span>
      {profile.focus[lang].map((f) => <span class="chip">{f}</span>)}
    </p>
  </section>

  <div class="mb-10">
    <AsciiOcean />
  </div>

  <div class="mb-12">
    <ActivityCalendar lang={lang} events={events} today={today} />
  </div>

  <section aria-labelledby="recent-heading">
    <div class="mb-3 flex items-baseline justify-between">
      <h2 id="recent-heading" class="section-title">{t('home.recent')}</h2>
      <a href={localePath(lang, '/notes/')} class="text-sm link">{t('home.allNotes')}</a>
    </div>
    {notes.length ? <NoteList lang={lang} notes={notes.slice(0, 5)} /> : <p class="text-muted">{t('notes.empty')}</p>}
  </section>
</BaseLayout>
