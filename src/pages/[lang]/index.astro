---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileHero from '../../components/ProfileHero.astro';
import ActivityCalendar from '../../components/ActivityCalendar.astro';
import NoteList from '../../components/NoteList.astro';
import GraphView from '../../components/GraphView.astro';
import { LANGS, useTranslations, type Lang } from '../../i18n/ui.ts';
import { localePath } from '../../i18n/paths.ts';
import { getGardenView } from '../../lib/garden.ts';
import { previewGraph } from '../../lib/graph.ts';
import { todayInTimeZone } from '../../lib/dates.ts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { notes, notesById, events, github, graph, githubThrough, githubActivity } = await getGardenView(lang);
// One activity per logical note, whatever its languages; only the title is localised.
const localEvents = events.map((e) => (e.noteId && e.type !== 'question' ? { ...e, title: notesById.get(e.noteId)?.data.title ?? e.title } : e));
const today = todayInTimeZone();
// Article Graph, connected nodes only, capped so the card stays quiet.
const preview = previewGraph(graph, 'article', 24);
---

<BaseLayout lang={lang} wide immersive>
  <ProfileHero slot="hero" lang={lang} />

  <section id="log" class="scroll-mt-20 mb-12" aria-labelledby="log-heading">
    <h2 id="log-heading" class="section-title">{t('home.log')}</h2>
    <p class="mt-2 mb-5 max-w-[46rem] text-muted leading-relaxed">{t('home.intro')}</p>
    <ActivityCalendar
      lang={lang}
      events={localEvents}
      github={github}
      today={today}
      githubThrough={githubThrough}
      githubError={!!githubActivity?.lastError}
    />
  </section>

  <section class="mb-12" aria-labelledby="graph-heading">
    <div class="mb-3 flex items-baseline justify-between gap-4">
      <h2 id="graph-heading" class="section-title">{t('graph.preview')}</h2>
      <a href={localePath(lang, '/graph/')} class="text-sm link">{t('graph.open')}</a>
    </div>
    {
      preview.nodes.length ? (
        <GraphView lang={lang} graph={preview} variant="preview" mode="article" />
      ) : (
        <p class="text-sm text-muted border border-dashed border-line rounded-lg p-4">{t('graph.empty')}</p>
      )
    }
  </section>

  <section aria-labelledby="recent-heading">
    <div class="mb-3 flex items-baseline justify-between">
      <h2 id="recent-heading" class="section-title">{t('home.recent')}</h2>
      <a href={localePath(lang, '/notes/')} class="text-sm link">{t('home.allNotes')}</a>
    </div>
    {notes.length ? <NoteList lang={lang} notes={notes.slice(0, 5)} /> : <p class="text-muted">{t('notes.empty')}</p>}
  </section>
</BaseLayout>
