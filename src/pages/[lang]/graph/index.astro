---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GraphView from '../../../components/GraphView.astro';
import { LANGS, useTranslations, type Lang } from '../../../i18n/ui.ts';
import { getGarden } from '../../../lib/garden.ts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { graph } = await getGarden();
---

<BaseLayout lang={lang} title={t('graph.title')} wide>
  <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">{t('graph.title')}</h1>
  <p class="mt-2 text-muted">{t('graph.intro')}</p>
  <div class="mt-6">
    <GraphView lang={lang} graph={graph} variant="full" mode="article" />
  </div>
  <p class="mt-3 text-xs text-muted font-mono">{t('graph.howto')}</p>
</BaseLayout>
