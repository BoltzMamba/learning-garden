---
/**
 * Root: redirect to the visitor's explicitly chosen language, else English
 * (see src/i18n/entry.ts). Static links are shown for no-JS visitors and crawlers.
 */
import { localePath, url } from '../i18n/paths.ts';
import { entryRedirectScript } from '../i18n/entry.ts';
import { DEFAULT_LANG, htmlLang, LANGS, languages } from '../i18n/ui.ts';

const targets = Object.fromEntries(LANGS.map((l) => [l, localePath(l, '/')]));
const script = entryRedirectScript(targets, DEFAULT_LANG);
---

<!doctype html>
<html lang={htmlLang[DEFAULT_LANG]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Learning Garden</title>
    <meta name="description" content="A personal technical knowledge garden, in English and Chinese." />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={new URL(targets[DEFAULT_LANG], Astro.site)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(targets[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(targets[DEFAULT_LANG], Astro.site)} />
    <script is:inline set:html={script} />
    <style>
      body { font-family: ui-monospace, Menlo, Consolas, monospace; background: #10151a; color: #e9f1ee; display: grid; place-items: center; min-height: 100vh; margin: 0; }
      a { color: #78bba4; margin: 0 0.75rem; }
    </style>
  </head>
  <body>
    <p>
      {LANGS.map((l) => <a href={targets[l]} hreflang={htmlLang[l]}>{languages[l]}</a>)}
    </p>
  </body>
</html>
