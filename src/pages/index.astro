---
/**
 * Root: choose a UI language (saved choice > browser language > zh) and
 * redirect. Static links are shown for no-JS visitors and crawlers.
 */
import { localePath, url } from '../i18n/paths.ts';
import { DEFAULT_LANG, htmlLang, LANGS, languages } from '../i18n/ui.ts';

const targets = Object.fromEntries(LANGS.map((l) => [l, localePath(l, '/')]));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Learning Garden</title>
    <meta name="description" content="A personal technical knowledge garden. 个人技术知识花园。" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    {LANGS.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(targets[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(targets[DEFAULT_LANG], Astro.site)} />
    <script is:inline define:vars={{ targets, fallback: DEFAULT_LANG }}>
      var lang = null;
      try { lang = localStorage.getItem('lg-lang'); } catch (e) {}
      if (!targets[lang]) {
        var langs = navigator.languages || [navigator.language || ''];
        lang = fallback;
        for (var i = 0; i < langs.length; i++) {
          var l = String(langs[i]).toLowerCase();
          if (l.indexOf('zh') === 0) { lang = 'zh'; break; }
          if (l.indexOf('en') === 0) { lang = 'en'; break; }
        }
      }
      location.replace(targets[lang]);
    </script>
    <style>
      body { font-family: ui-monospace, Menlo, Consolas, monospace; background: #10151a; color: #e9f1ee; display: grid; place-items: center; min-height: 100vh; margin: 0; }
      a { color: #78bba4; margin: 0 0.75rem; }
    </style>
  </head>
  <body>
    <p>
      {LANGS.map((l) => <a href={targets[l]}>{languages[l]}</a>)}
    </p>
  </body>
</html>
