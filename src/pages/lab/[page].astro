---
/**
 * Dev-only lab: /lab/creatures/ renders every big creature on its own, in
 * both themes, with the production rasteriser. Not generated in builds.
 */
import '../../styles/global.css';
import { KINDS } from '../../scripts/creatures/shapes.ts';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: 'creatures' } }] : [];
}

const names: Record<string, string> = {
  classic: 'Classic shark 普通鲨鱼',
  hammerhead: 'Hammerhead 锤头鲨',
  greathammer: 'Great hammerhead 无沟双髻鲨',
  tiger: 'Tiger shark 虎鲨',
  zebra: 'Zebra shark 豹纹鲨',
  mako: 'Shortfin mako 灰鲭鲨',
  thresher: 'Thresher 长尾鲨',
  nurse: 'Nurse shark 铰口鲨',
  whaleshark: 'Whale shark 鲸鲨',
  manta: 'Manta ray 蝠鲼',
  sunfish: 'Ocean sunfish 翻车鱼',
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <title>Creature lab</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <style>
      body { margin: 0; font-family: var(--font-mono); background: var(--bg); color: var(--text); }
      .theme { padding: 16px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(560px, 1fr)); gap: 12px; }
      figure { margin: 0; border: 1px solid var(--border); background: var(--bg); }
      canvas { display: block; width: 100%; height: 420px; }
      figcaption { padding: 6px 10px; font-size: 13px; border-top: 1px solid var(--border); }
      h2 { margin: 8px 0 12px; font-size: 14px; }
    </style>
  </head>
  <body>
    {
      ['light', 'dark'].map((theme) => (
        <section class="theme" data-theme={theme} style="background: var(--bg)">
          <h2>{theme}</h2>
          <div class="grid">
            {KINDS.map((k) => (
              <figure>
                <canvas data-kind={k} />
                <figcaption>{names[k] ?? k}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))
    }
    <script>
      import { CreatureWorld } from '../../scripts/creatures/creatures.ts';
      import { CreatureRaster, readCreaturePalette } from '../../scripts/creatures/raster.ts';
      import type { CreatureKind } from '../../scripts/creatures/shapes.ts';

      // Theme sections set data-theme on themselves; mirror the root tokens.
      for (const sec of document.querySelectorAll<HTMLElement>('section[data-theme="dark"]')) {
        const probe = document.createElement('div');
        document.documentElement.dataset.theme = 'dark';
        const dark = getComputedStyle(document.documentElement);
        for (const name of ['--bg', '--text', '--border', '--creature-shadow', '--creature-light', '--creature-glyph-light', '--creature-glyph-dark', '--creature-edge', '--creature-eye', '--creature-glint', '--creature-accents', '--creature-tint']) {
          sec.style.setProperty(name, dark.getPropertyValue(name));
        }
        document.documentElement.dataset.theme = 'light';
        probe.remove();
      }

      const params = new URLSearchParams(location.search);
      const phase = Number(params.get('phase') ?? 1.3);

      async function draw() {
        await document.fonts.ready;
        for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas[data-kind]')) {
          const kind = canvas.dataset.kind as CreatureKind;
          const rect = canvas.getBoundingClientRect();
          const dpr = Math.min(2, window.devicePixelRatio || 1);
          canvas.width = rect.width * dpr;
          canvas.height = rect.height * dpr;
          const ctx = canvas.getContext('2d')!;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          const cw = 12;
          const ch = 17;
          const cols = Math.ceil(rect.width / cw);
          const rows = Math.ceil(rect.height / ch);
          const palette = readCreaturePalette(canvas.closest('section')!);

          // Grid
          ctx.fillStyle = `rgb(${palette.bg.join(',')})`;
          ctx.fillRect(0, 0, rect.width, rect.height);
          ctx.strokeStyle = getComputedStyle(canvas.closest('section')!).getPropertyValue('--border');
          ctx.globalAlpha = 0.35;
          ctx.beginPath();
          for (let c = 0; c <= cols; c++) { ctx.moveTo(c * cw + 0.5, 0); ctx.lineTo(c * cw + 0.5, rect.height); }
          for (let r = 0; r <= rows; r++) { ctx.moveTo(0, r * ch + 0.5); ctx.lineTo(rect.width, r * ch + 0.5); }
          ctx.stroke();
          ctx.globalAlpha = 1;

          const world = new CreatureWorld();
          const L = kind === 'sunfish' ? 300 : kind === 'manta' ? 400 : 440;
          const heading = -0.18;
          const cx = rect.width / 2 + Math.cos(heading) * L * (kind === 'manta' ? 0.28 : 0.42);
          const cy = rect.height / 2 + Math.sin(heading) * L * 0.42 + (kind === 'manta' ? -40 : 0);
          const cr = world.make(1, kind, L, cx, cy, heading);
          cr.phase = phase;
          cr.speed = 40;
          const raster = new CreatureRaster();
          raster.resize(cols, rows, cw, ch);
          raster.rasterize([cr]);
          ctx.font = `600 ${Math.round(ch * 0.74)}px "JetBrains Mono", ui-monospace, monospace`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          raster.draw(ctx, palette, 0);
          let cells = 0;
          for (let i = 0; i < cols * rows; i++) if (raster.flag[i]) cells++;
          canvas.parentElement!.querySelector('figcaption')!.append(` · ${cells} cells`);
        }
        document.body.dataset.ready = '1';
      }
      draw();
    </script>
  </body>
</html>
