---
/**
 * Homepage hero: the owner's identity floating inside the ASCII ocean.
 * Layers: grid (CSS) → ocean canvas → readability clearing → profile.
 */
import AsciiOcean from './AsciiOcean.astro';
import { useTranslations, type Lang } from '../i18n/ui.ts';
import { localePath } from '../i18n/paths.ts';
import { profile } from '../data/profile.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="ocean-hero" data-ocean-host aria-labelledby="hero-name">
  <AsciiOcean />
  <div class="ocean-clearing" aria-hidden="true"></div>
  <div class="ocean-fade" aria-hidden="true"></div>

  <div class="hero-profile" data-ocean-avoid>
    <img
      class="hero-avatar"
      src={profile.avatar}
      alt={t('home.avatarAlt', { name: profile.name })}
      width="112"
      height="112"
      decoding="async"
      fetchpriority="high"
    />
    <h1 id="hero-name" class="hero-name">{profile.name}</h1>
    <p class="hero-intro">{profile.intro[lang]}</p>
    <ul class="hero-interests" aria-label={t('home.focus')}>
      {profile.focus[lang].map((f) => <li>{f}</li>)}
    </ul>
    <p class="hero-links">
      <a class="hero-link" href={`https://github.com/${profile.github}`} rel="me">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        GitHub
      </a>
      <a class="hero-link hero-link-primary" href={localePath(lang, '/notes/')}>{t('home.readNotes')} →</a>
    </p>
  </div>

  <a class="hero-scroll" href="#log">
    <span aria-hidden="true">↓</span>
    {t('home.scroll')}
  </a>
  <p class="hero-hint" aria-hidden="true">{t('home.oceanHint')}</p>
</section>

<style>
  .ocean-hero {
    /* Cell size is set by the renderer (glyph-shaped cells); this is the no-JS fallback. */
    --ocean-cw: 12px;
    --ocean-ch: 17px;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 5.5rem 1rem 6rem;
    overflow: hidden;
    background-color: var(--bg);
    /* Character-cell grid; also the no-JS fallback. Cells align with the canvas grid. */
    background-image:
      linear-gradient(to bottom, var(--ocean-grid) 1px, transparent 1px),
      linear-gradient(to right, var(--ocean-grid) 1px, transparent 1px);
    background-size: var(--ocean-cw) var(--ocean-ch);
  }

  /* Soft, unbounded clearing behind the profile (no panel, no border). */
  .ocean-clearing {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse min(46rem, 92vw) min(26rem, 62svh) at 50% 50%,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 82%, transparent) 38%,
      color-mix(in srgb, var(--bg) 35%, transparent) 64%,
      transparent 80%
    );
  }
  /* Ocean dissolves into the page below: no hard bottom edge. */
  .ocean-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 22%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }

  .hero-profile {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 36rem;
  }
  .hero-avatar {
    width: 6rem;
    height: 6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--bg) 80%, transparent);
    object-fit: cover;
  }
  @media (min-width: 640px) {
    .hero-avatar {
      width: 7rem;
      height: 7rem;
    }
  }
  .hero-name {
    margin-top: 1.5rem;
    font-size: clamp(2.5rem, 8vw, 4.25rem);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--text);
  }
  .hero-intro {
    margin-top: 1rem;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: balance;
  }
  .hero-interests {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .hero-interests li + li::before {
    content: '·';
    margin: 0 0.6rem;
    color: var(--text-muted);
  }
  .hero-links {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--text);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    backdrop-filter: blur(2px);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .hero-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hero-link-primary {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    color: var(--accent);
  }

  .hero-scroll {
    position: absolute;
    z-index: 2;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
  }
  .hero-scroll:hover {
    color: var(--accent);
  }
  .hero-scroll span {
    animation: bob 2.4s ease-in-out infinite;
  }
  .hero-hint {
    position: absolute;
    z-index: 2;
    right: 1.5rem;
    bottom: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: color-mix(in srgb, var(--text-muted) 75%, transparent);
    display: none;
  }
  @media (hover: hover) and (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .hero-hint {
      display: block;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll span {
      animation: none;
    }
  }
</style>
