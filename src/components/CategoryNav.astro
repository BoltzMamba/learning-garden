---
import type { Note } from '../lib/garden.ts';
import { categoryLabel, useTranslations, type Lang } from '../i18n/ui.ts';
import { localePath } from '../i18n/paths.ts';

interface Props {
  lang: Lang;
  notes: Note[];
  /** Currently selected category, if any. */
  current?: string;
}
const { lang, notes, current } = Astro.props;
const t = useTranslations(lang);

const counts = new Map<string, number>();
for (const n of notes) counts.set(n.data.category, (counts.get(n.data.category) ?? 0) + 1);
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<nav aria-label={t('notes.categories')} class="flex flex-wrap items-center gap-2">
  <span class="text-sm text-muted mr-1">{t('notes.categories')}:</span>
  <a class="chip" href={localePath(lang, '/notes/')} aria-current={current ? undefined : 'page'}>
    {t('notes.all')} <span aria-hidden="true">·</span>
    {notes.length}
  </a>
  {
    categories.map(([cat, n]) => (
      <a
        class="chip"
        href={localePath(lang, `/notes/category/${cat}/`)}
        aria-current={current === cat ? 'page' : undefined}
      >
        {categoryLabel(cat, lang)} <span aria-hidden="true">·</span>
        {n}
      </a>
    ))
  }
</nav>
