---
/**
 * Renders ```mermaid code blocks as diagrams in the browser.
 *
 * Shiki has already turned each block into <pre data-language="mermaid">; its
 * text content is the diagram source. The mermaid library is loaded only on
 * pages that contain such a block, and diagrams are redrawn when the reader
 * switches between light and dark themes. If rendering fails, the code block
 * stays as it is, so the source is never lost.
 *
 * Mermaid sizes each node by measuring its label in a scratch element. That
 * element is placed inside the diagram's own <figure>, so the measurement sees
 * the same CSS as the finished diagram; measured under <body> instead, the
 * labels inherit .prose's larger line-height after insertion and overflow
 * (wrapped lines get clipped). Fonts are awaited for the same reason.
 */
---

<script>
  const blocks = [...document.querySelectorAll<HTMLPreElement>('.prose pre[data-language="mermaid"]')];

  /** Smallest scale a diagram may shrink to (Mermaid's 16px labels → 12px). */
  const MIN_SCALE = 0.75;

  if (blocks.length > 0) {
    const { default: mermaid } = await import('mermaid');
    const sources = blocks.map((pre) => pre.textContent ?? '');
    const figures = blocks.map((pre) => {
      const figure = document.createElement('figure');
      figure.className = 'mermaid-diagram';
      figure.hidden = true;
      pre.after(figure);
      return figure;
    });

    await document.fonts?.ready;
    const fontFamily = getComputedStyle(document.body).fontFamily;

    let run = 0;
    const render = async () => {
      const current = ++run;
      const dark = document.documentElement.dataset.theme === 'dark';
      mermaid.initialize({
        startOnLoad: false,
        theme: dark ? 'dark' : 'default',
        securityLevel: 'strict',
        fontFamily,
        flowchart: { wrappingWidth: 180 },
      });
      for (const [i, pre] of blocks.entries()) {
        try {
          figures[i].hidden = false; // must be laid out for Mermaid to measure inside it
          const { svg } = await mermaid.render(`mermaid-${i}-${current}`, sources[i], figures[i]);
          if (current !== run) return; // a newer theme switch took over
          figures[i].innerHTML = svg;
          // Shrink with the column, but never below MIN_SCALE of natural size; narrower than that, the figure scrolls.
          const drawn = figures[i].querySelector('svg');
          const naturalWidth = drawn?.viewBox.baseVal?.width;
          if (drawn && naturalWidth) drawn.style.minWidth = `${Math.round(naturalWidth * MIN_SCALE)}px`;
          figures[i].hidden = false;
          pre.hidden = true;
        } catch (error) {
          console.error('Mermaid diagram could not be rendered', error);
          figures[i].hidden = true;
          pre.hidden = false;
        }
      }
    };

    await render();
    new MutationObserver(() => void render()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>

<style is:global>
  .prose figure.mermaid-diagram {
    margin: 1.5em 0;
    overflow-x: auto;
    /* The svg's min-width must scroll inside the figure, not widen the article column. */
    contain: inline-size;
    text-align: center;
    /* Label typography Mermaid measures with; .prose's 1.8 / anywhere would overflow the boxes. */
    line-height: 1.5;
    overflow-wrap: normal;
  }
  .prose figure.mermaid-diagram svg {
    max-width: 100%;
    height: auto;
  }
</style>
