---
/**
 * Full-bleed ASCII ocean background. Place inside a positioned host with
 * `data-ocean-host`; an element marked `data-ocean-avoid` in the host
 * becomes the clearing that fish swim around.
 *
 * Purely decorative: aria-hidden, pointer-events: none. Without JS (or
 * before it runs) the host still shows the CSS character grid.
 */
---

<canvas class="ocean-canvas" aria-hidden="true" data-ocean-canvas></canvas>

<style>
  .ocean-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  import { AsciiOcean } from '../scripts/ascii-ocean.ts';

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-ocean-canvas]')) {
    const host = canvas.closest<HTMLElement>('[data-ocean-host]');
    if (!host) continue;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ocean = new AsciiOcean(host, canvas, host.querySelector<HTMLElement>('[data-ocean-avoid]'), motion.matches);

    let visible = true;
    const sync = () => (visible && !document.hidden && !motion.matches ? ocean.start() : ocean.stop());

    // Pause when scrolled away or the tab is hidden.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(host);
    document.addEventListener('visibilitychange', sync);
    motion.addEventListener('change', () => {
      ocean.setReducedMotion(motion.matches);
      sync();
    });

    // Theme switch → re-read colours from CSS variables.
    new MutationObserver(() => ocean.readPalette()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    let resizeTimer = 0;
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      // Mobile browsers fire resize when the URL bar shows/hides; only rebuild on width changes
      // or substantial height changes.
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (window.innerWidth !== lastWidth || Math.abs(host.clientHeight - canvas.clientHeight) > 120) {
          lastWidth = window.innerWidth;
          ocean.resize();
        }
      }, 150);
    });
    document.fonts?.ready.then(() => ocean.readPalette());

    host.addEventListener('pointermove', (e) => ocean.pointer(e.clientX, e.clientY), { passive: true });
    sync();
  }
</script>
